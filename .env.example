# AXIAM Domo Demo — the keys an operator sets by hand.
#
#   cp .env.example .env
#   $EDITOR .env
#
# `.env` is per machine and is NOT committed: DOMO_LAN_IP in particular differs
# on every host, which is the whole reason the two reference machines — the
# amd64 laptop and the Raspberry Pi 5 — can share one compose file (D-06).
#
# ── Five keys, and only five ──────────────────────────────────────────────────
#
# `deploy/compose.yml` marks every `${VAR:?message}` guard by who supplies the
# value: a message opening with the word `operator` means you set it, and one
# opening with `generated` means `just secrets` mints it into
# `.secrets/generated.env` on first run. The list below is derived from that
# marker, and `just verify`'s operator-docs group derives its check from the same
# marker — so the documentation and the gate cover one subset by construction
# rather than two that have to be kept in agreement.
#
# The generated set — the auth pepper, the JWT key pair, both spellings of the
# PKI encryption key, the database and broker passwords, and the rest — carries
# `${VAR:?}` guards too, because a secret that rendered empty would start AXIAM
# in a silently insecure state. They are deliberately ABSENT from this file: an
# operator who set one by hand would replace a minted 256-bit value with a weaker
# one (D-13). If you ever see a generated key offered here, the guard in
# `deploy/compose.yml` was marked wrong — fix it there.
#
# The stack reads its values from `.secrets/generated.env` and from your `.env`.
# This file is documentation; nothing reads it at run time.


# The AXIAM server and console image tag. Server and SDK move TOGETHER (D-01):
# this demo's whole claim is that it names the exact AXIAM version it validates,
# and a newer SDK against an older server validates neither. The Rust SDK is
# pinned to the matching version in Cargo.toml.
#
# Pinned at beta16 on purpose. AXIAM 1.0.0-beta17 exists as a git tag and on
# crates.io and fixes eight of this demo's findings, but its container images
# were never published — `:1.0.0-beta17` returns `manifest unknown`. See
# docs/dogfooding-upstream-status.md before changing this.
AXIAM_IMAGE_TAG=1.0.0-beta16

# The portal host name. The AXIAM console is served at `axiam.<this>` — a
# separate host rather than a separate port, because cookies are host-scoped
# (D-30). It is also AXIAM's OIDC issuer identifier and its WebAuthn relying-party
# id, so changing it after a run invalidates any registered passkey.
#
# It must RESOLVE on every machine that will open the demo. `just preflight`
# checks and prints the `avahi-publish` command when it does not; `/etc/hosts`
# works just as well. A `.local` name is mDNS and needs avahi running.
DOMO_HOST=domo.local

# This machine's LAN address. Three listeners are published on it rather than on
# the loopback, because devices and browsers on other machines have to reach them
# (D-05): 443 (Caddy), 8090 (AXIAM's own TLS listener, which devices call
# directly) and 8883 (MQTTS).
#
#   hostname -I | awk '{print $1}'
#
# Set it to the real address, not 0.0.0.0: the certificates are issued for the
# names and addresses in `deploy/pki/listeners.conf`, which reads this value.
DOMO_LAN_IP=192.168.1.10

# The AXIAM organization slug, created once by the org-bootstrap stage. The two
# demo tenants (`lakeside`, `summit`) live inside it. Lower-case, digits and
# hyphens.
DOMO_ORG_SLUG=domo

# The compose project name. Every volume this demo creates is prefixed with it —
# `<name>_surrealdb-data`, `<name>_postgres-data`, and so on — and `just
# demo-reset` removes exactly those, one by one and by explicit name.
#
# Keep it distinct from any other compose project on the machine. The sibling
# AXIAM checkout runs its own stack here; a shared project name is how a reset of
# one silently destroys the other's development data (D-09).
COMPOSE_PROJECT_NAME=domo


# ── Not for a demo run ────────────────────────────────────────────────────────
#
# DOMO_FAIL_AT is a TESTING AID and has no role in a demo. Set it to a stage name
# and `just up` aborts at that stage's entry — before any work and before its
# marker — so the resumable-checklist property (PLAT-05, D-34) can be asserted
# rather than assumed:
#
#   DOMO_FAIL_AT=catalog just up     # stops at catalog
#   just up                          # resumes at catalog and completes
#
# Stages: preflight pki axiam-up org-bootstrap tenants catalog service-certs
#         broker platform-up verify
#
# Leave it unset. Do not put it in `.env`; pass it inline when you want it.
#DOMO_FAIL_AT=
