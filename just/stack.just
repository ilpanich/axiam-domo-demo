# Stack lifecycle and the Phase 1 tracer.
#
# Ownership split (D-34): `just` owns the Docker lifecycle on the host —
# compose up/down, log scraping, readiness polling. `domo-bootstrap` owns the
# AXIAM API work and runs as a one-shot compose service on the compose network,
# so the demo machine needs no cargo toolchain (D-35).

set shell := ["bash", "-euo", "pipefail", "-c"]

compose_file := "deploy/compose.yml"
env_file := ".secrets/generated.env"
min_free_gb := "8"

# --- helpers -----------------------------------------------------------------

# Everything runs through this: it sources the generated secrets and exports the
# host uid/gid so the one-shot tools write operator-readable files.
#
# `.env` (operator keys) is sourced here rather than left to Compose's own
# discovery: Compose looks for `.env` in the PROJECT directory, which defaults
# to the compose file's own directory (`deploy/`), while the operator's file
# belongs at the repository root. Exporting into the environment sidesteps the
# mismatch without moving the project directory — which would repoint every
# relative volume path in the file.
_dc +ARGS:
    @set -a; [ -f .env ] && . ./.env; [ -f "{{env_file}}" ] && . "{{env_file}}"; set +a; \
    export DOMO_UID="$(id -u)" DOMO_GID="$(id -g)"; \
    docker compose -f "{{compose_file}}" {{ARGS}}

# Raw compose passthrough: `just compose ps`
compose +ARGS:
    @just _dc {{ARGS}}

logs *ARGS:
    @just _dc logs {{ARGS}}

# --- preflight ---------------------------------------------------------------

# D-35's checks, as a standalone script so the same code runs from `just up`,
# from a bare shell, and on the Pi.
#
# The script is located from the JUSTFILE's directory rather than from the
# working directory: a recipe must be able to find its own script no matter
# where `just` was pointed.
#
# Two facts only `just` knows are handed in:
#   DOMO_STACK_RUNNING  our own containers hold the published ports, which is
#                       the normal state of a second run and not a conflict
#                       (plan 01-01 learned this the hard way).
#   DOMO_NEED_CARGO     a local build is about to happen, so cargo matters.
#                       Unset on the demo machine — the Pi never needs it.
preflight:
    @set -a; if [ -f .env ]; then . ./.env; fi; set +a; \
    if [ -n "$(just _dc ps -q 2>/dev/null)" ]; then export DOMO_STACK_RUNNING=1; fi; \
    bash "{{justfile_directory()}}/scripts/preflight.sh"

# --- secrets -----------------------------------------------------------------

# Mint every `generated`-marked compose variable, once. Never regenerated:
# RabbitMQ applies its default user only on the first boot of an empty volume,
# so a regenerated password would silently stop matching the broker. PostgreSQL
# behaves identically with its own data volume.
#
# "Never regenerated" is not the same as "never added to". A checkout that was
# provisioned before a later plan introduced a new generated key would otherwise
# hit that key's `:?generated - run 'just up'` guard forever, and the guard's
# advice would be a lie: `just up` would refuse for the same reason. The loop in
# the already-minted branch tops up any key that is MISSING and touches none
# that is present. Every future generated key belongs in that list.
secrets:
    @if [ -f "{{env_file}}" ]; then \
        umask 077; \
        for k in POSTGRES_PASSWORD; do \
            grep -q "^$k=" "{{env_file}}" && continue; \
            echo "$k=$(openssl rand -hex 24)" >> "{{env_file}}"; \
            echo "  ✓ added missing $k to the existing {{env_file}}"; \
        done; \
        echo "  ✓ secrets already minted"; exit 0; \
    fi; \
    echo "→ minting stack secrets"; \
    umask 077; mkdir -p .secrets; \
    hex() { openssl rand -hex 32; }; \
    jwt_priv="$(openssl genpkey -quiet -algorithm ed25519)"; \
    jwt_pub="$(printf '%s\n' "$jwt_priv" | openssl pkey -pubout)"; \
    pki_key="$(hex)"; \
    { \
      echo "# Generated by 'just secrets'. Never edit by hand, never commit."; \
      echo "AXIAM__DB__USERNAME=domo_$(openssl rand -hex 4)"; \
      echo "AXIAM__DB__PASSWORD=$(openssl rand -hex 24)"; \
      echo "RABBITMQ_DEFAULT_USER=domo_$(openssl rand -hex 4)"; \
      echo "RABBITMQ_DEFAULT_PASS=$(openssl rand -hex 24)"; \
      echo "# Applied only on the first boot of an empty postgres-data volume,"; \
      echo "# exactly like RabbitMQ's above — hence persisted, not regenerated."; \
      echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"; \
      echo "AXIAM__AUTH__PEPPER=$(hex)"; \
      echo "AXIAM__AUTH__MFA_ENCRYPTION_KEY=$(hex)"; \
      echo "AXIAM__AUTH__FEDERATION_ENCRYPTION_KEY=$(hex)"; \
      echo "AXIAM__AUTH__OPAQUE_SESSION_KEY=$(hex)"; \
      echo "AXIAM__AUTH__OPAQUE_SETUP_KEY=$(hex)"; \
      echo "AXIAM__EMAIL_ENCRYPTION_KEY=$(hex)"; \
      echo "AXIAM__GDPR_PSEUDONYM_PEPPER=$(hex)"; \
      echo "AXIAM__AMQP__SIGNING_KEY=$(hex)"; \
      echo "# P-9: both spellings, same value."; \
      echo "AXIAM__AUTH__PKI_ENCRYPTION_KEY=$pki_key"; \
      printf 'AXIAM__AUTH__JWT_PRIVATE_KEY_PEM="%s"\n' "$jwt_priv"; \
      printf 'AXIAM__AUTH__JWT_PUBLIC_KEY_PEM="%s"\n' "$jwt_pub"; \
    } > "{{env_file}}"; \
    chmod 600 "{{env_file}}"; \
    echo "  ✓ secrets minted into {{env_file}}"

# --- lifecycle ---------------------------------------------------------------

# `pki` lives in `just/pki.just` alongside `verify-pki` and `pki-rotate-root`.
# `just` flattens imports into a single namespace, so the dependency below
# resolves across the module boundary and defining it twice is an error.

# Both images. `domo-bootstrap` sits in the `tools` profile so it never starts
# with `up`, but it still has to be BUILT — and `domo-probe` reuses the image it
# produces rather than defining a second, identical build.
build:
    @echo "→ building images"
    @just _dc build device-twin domo-bootstrap

down:
    @just _dc down

# Poll AXIAM's TLS listener directly. The image's own healthcheck subcommand
# cannot do this: it probes plain HTTP and trusts only webpki roots, so it can
# never see a listener fronted by a private CA (P-4, DF-016).
_wait-axiam:
    @echo "→ waiting for AXIAM"
    @for i in $(seq 1 60); do \
        if curl -sf --cacert .secrets/pki/root.pem https://127.0.0.1:8090/health >/dev/null 2>&1; then \
            echo "  ✓ AXIAM is up"; exit 0; \
        fi; \
        sleep 2; \
    done; \
    echo "✗ AXIAM did not become ready in 120s"; \
    just _dc logs --no-color --tail 40 axiam-server; \
    exit 1

# Poll the edge, which is the last thing to become true on a cold start: Caddy
# resolves its upstreams per request, so it answers long before the Twin behind
# it does. Asking the Twin's health endpoint THROUGH Caddy proves both hops at
# once, which is the property `platform-up` claims.
#
# The host name is pinned to the LAN address when it does not resolve here,
# exactly as `just edge-verify` does: publishing an mDNS name is the operator's
# job (and is printed by preflight), not a reason for `just up` to fail.
_wait-edge:
    @echo "→ waiting for the edge"
    @set -a; if [ -f .env ]; then . ./.env; fi; set +a; \
    host="${DOMO_HOST:-domo.local}"; pin=""; \
    if ! getent hosts "$host" >/dev/null 2>&1; then \
        pin="--resolve $host:443:${DOMO_LAN_IP:-127.0.0.1}"; \
    fi; \
    for i in $(seq 1 45); do \
        if curl -sf $pin --cacert dist/trust/domo-root.pem \
                "https://$host/api/twin/healthz" >/dev/null 2>&1; then \
            echo "  ✓ the Device Twin answers through Caddy"; exit 0; \
        fi; \
        sleep 2; \
    done; \
    echo "✗ the edge did not answer in 90s"; \
    just _dc logs --no-color --tail 20 caddy; \
    just _dc logs --no-color --tail 20 device-twin; \
    exit 1

# Scrape the single-use setup token from the FULL log history.
#
# Not `--since`: the token is emitted once per SurrealDB volume, at first boot,
# and any later restart would push it outside a time-bounded window. Persisted
# at 0600 the moment it is seen (DF-019).
_setup-token:
    @mkdir -p .secrets/state; umask 077; \
    if [ -s .secrets/state/setup-token ]; then echo "  ✓ setup token already saved"; exit 0; fi; \
    tok="$(just _dc logs --no-color axiam-server 2>/dev/null \
            | grep -o '"setup_token":"[^"]*"' | head -1 | cut -d'"' -f4 || true)"; \
    if [ -z "$tok" ]; then \
        echo "  … no setup token in the log (already consumed, or already bootstrapped)"; \
    else \
        printf '%s' "$tok" > .secrets/state/setup-token; \
        chmod 600 .secrets/state/setup-token; \
        echo "  ✓ setup token captured"; \
    fi

# `DOMO_FAIL_AT` has a container boundary to cross, and crossing it is this
# recipe's job rather than the operator's. `domo-bootstrap` is a one-shot
# invoked through `docker compose run --rm`, so a value set in the operator's
# shell reaches `just` and stops there unless this invocation carries it
# further. Naming a bootstrap-owned stage such as `catalog` would otherwise do
# nothing at all, and the resume assertion would fail with no hint why.
#
# Passed on the command line rather than declared in `deploy/compose.yml`: a
# compose-level declaration would have to take a defaulted form to avoid
# looking like an operator-set key to the `.env.example` drift gate, and the
# command line keeps a testing aid out of the production topology entirely.
_stage +ARGS:
    @if [ -n "${DOMO_FAIL_AT:-}" ]; then \
        just _dc run --rm --quiet-pull -e DOMO_FAIL_AT="$DOMO_FAIL_AT" domo-bootstrap {{ARGS}}; \
    else \
        just _dc run --rm --quiet-pull domo-bootstrap {{ARGS}}; \
    fi

_probe +ARGS:
    @just _dc run --rm --quiet-pull domo-probe {{ARGS}}

# --- multi-architecture images (PLAT-02) --------------------------------------

# Build both of this repository's images for both reference architectures.
#
# The demo runs on an amd64 laptop and on an arm64 Raspberry Pi 5 from ONE
# compose file (D-06). Every third-party image in the stack already publishes
# both; these two are the ones we owe.
#
# # What this produces
#
#   domo-{twin,tools}:dev          the native image the local stack runs
#   domo-{twin,tools}:dev-arm64    the Pi's image, in the local daemon so
#                                  `just images-verify` can assert it
#   dist/images/domo-*-arm64.tar   the same image as a transferable archive:
#                                  `docker load` on the Pi, then tag it `:dev`
#
# A single-tag multi-architecture MANIFEST LIST is deliberately not produced.
# It would need a registry to live in, and this demo is LAN-only with no
# registry (D-05) — a manifest list cannot be loaded into a daemon at all. The
# per-architecture tag plus the archive is the form that actually reaches the
# second machine.
#
# # Disk
#
# This machine has run out of space mid-session, and the resulting failures read
# as linker or compiler bugs. Free space is printed before the build and
# asserted after it, and the lock below keeps two heavy builds from ever running
# at once — which is the rule the 25 GB figure exists to enforce.
images:
    #!/usr/bin/env bash
    set -uo pipefail

    lock=dist/.images.lock
    mkdir -p dist
    if ! mkdir "$lock" 2>/dev/null; then
      echo "✗ images: another image build is already running (${lock} exists)."
      echo "  Two heavy builds must not run in parallel below 25G free, and this"
      echo "  machine has run out of disk mid-session before. Wait for it, or remove"
      echo "  the lock directory if you are sure nothing else is building."
      exit 1
    fi
    trap 'rmdir "$lock" 2>/dev/null' EXIT

    free_gb() { df -BG --output=avail "$1" 2>/dev/null | tail -1 | tr -dc '0-9'; }

    echo "→ disk before the build"
    for mp in /home /; do printf '  … %s  %sG free\n' "$mp" "$(free_gb "$mp")"; done
    for mp in /home /; do
      a="$(free_gb "$mp")"
      if [ -n "$a" ] && [ "$a" -lt "{{min_free_gb}}" ]; then
        echo "✗ images: only ${a}G free on ${mp}, need {{min_free_gb}}G. Reclaim space first."
        exit 1
      fi
    done

    mkdir -p dist/images
    tag="${DOMO_IMAGE_TAG:-dev}"

    for pair in "twin:domo-twin" "tools:domo-tools"; do
      target="${pair%%:*}"; image="${pair##*:}"
      for plat in linux/amd64 linux/arm64; do
        case "$plat" in
          linux/amd64) t="${image}:${tag}" ;;
          linux/arm64) t="${image}:${tag}-arm64" ;;
        esac
        printf '→ %s  %s\n' "$t" "$plat"
        docker buildx build --platform "$plat" --target "$target" -t "$t" --load \
          -f deploy/docker/Dockerfile.rust . >/dev/null 2>&1 \
          || { echo "✗ images: ${t} failed to build for ${plat}."; \
               echo "  A linker error naming the target triple means the builder image lacks a C"; \
               echo "  toolchain for that architecture — see the header of deploy/docker/Dockerfile.rust,"; \
               echo "  and the native-on-the-Pi fallback it documents."; exit 1; }
        printf '  ✓ %s\n' "$t"
      done
      docker save "${image}:${tag}-arm64" -o "dist/images/${image}-arm64.tar" \
        || { echo "✗ images: could not archive ${image}:${tag}-arm64"; exit 1; }
      printf '  ✓ dist/images/%s-arm64.tar  (docker load on the Pi)\n' "$image"
      # This build's own leftovers: the untagged intermediate images the rebuild
      # just orphaned. Dangling only — never a volume, never a tagged image.
      docker image prune -f >/dev/null 2>&1
    done

    echo "→ disk after the build"
    fail=0
    for mp in /home /; do
      a="$(free_gb "$mp")"
      printf '  … %s  %sG free\n' "$mp" "$a"
      if [ -n "$a" ] && [ "$a" -lt "{{min_free_gb}}" ]; then fail=1; fi
    done
    if [ "$fail" -eq 1 ]; then
      echo "  … under {{min_free_gb}}G free — dropping the BuildKit cache"
      docker builder prune -f >/dev/null 2>&1
      for mp in /home /; do
        a="$(free_gb "$mp")"
        if [ -n "$a" ] && [ "$a" -lt "{{min_free_gb}}" ]; then
          echo "✗ images: still only ${a}G free on ${mp} after cleaning. Reclaim space."
          exit 1
        fi
      done
    fi
    echo "✓ images"

# Assert that every image the compose file references can run on the Pi.
#
# Asked of the MANIFEST, not of the documentation: a third-party image is
# queried in its registry, and each of ours is checked twice — the image config
# says `arm64`, AND the ELF header of the binary inside it says `aarch64`.
#
# The second check is not belt and braces. The first cut of the cross-build
# produced an image whose config said `arm64` around an x86-64 binary, because a
# `TARGETPLATFORM` default shadowed BuildKit's value. Only the ELF header caught
# it, and it would otherwise have failed on the Pi and nowhere else (T-07-07).
images-verify:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    ok()  { printf '  ✓ %s\n' "$1"; }
    bad() { printf '  ✗ %s\n' "$1"; fail=1; }
    tag="${DOMO_IMAGE_TAG:-dev}"

    echo "→ images the compose file references"

    # e_machine, bytes 18-19 of the ELF header: 3e 00 is x86-64, b7 00 is aarch64.
    # Read rather than shelled out to `file`, which is not installed everywhere.
    elf_machine() {
      case "$(od -An -tx1 -j18 -N2 "$1" | tr -d ' ')" in
        3e00) echo x86-64 ;;
        b700) echo aarch64 ;;
        *)    echo unknown ;;
      esac
    }

    ours() {
      local image="$1" bin="$2" ref="${1}:${tag}-arm64" arch probe tmp
      arch="$(docker image inspect "$ref" 2>/dev/null | sed -n 's/.*"Architecture": "\([^"]*\)".*/\1/p' | head -1)"
      if [ -z "$arch" ]; then
        bad "${ref} does not exist — run 'just images'"
        return
      fi
      [ "$arch" = "arm64" ] \
        && ok "${ref}  image config: arm64" \
        || bad "${ref}  image config says '${arch}', expected arm64"
      probe="domo-imgverify-$$"
      tmp="$(mktemp -d)"
      if docker create --name "$probe" "$ref" >/dev/null 2>&1 \
         && docker cp "${probe}:/usr/local/bin/${bin}" "${tmp}/bin" >/dev/null 2>&1; then
        m="$(elf_machine "${tmp}/bin")"
        [ "$m" = "aarch64" ] \
          && ok "${ref}  ${bin} is a real aarch64 ELF" \
          || bad "${ref}  ${bin} is a ${m} ELF, not aarch64 — this image would fail on the Pi and nowhere else"
      else
        bad "${ref}  could not extract ${bin} to check its ELF header"
      fi
      docker rm -f "$probe" >/dev/null 2>&1
      rm -rf "$tmp"
    }

    # Everything not built here: asked of the registry, because a locally pulled
    # copy is single-architecture by construction and says nothing about the Pi.
    for ref in $(just _dc config --images 2>/dev/null | sort -u); do
      case "$ref" in
        domo-twin:*|domo-tools:*) continue ;;
      esac
      out="$(docker buildx imagetools inspect "$ref" 2>&1)"
      if printf '%s' "$out" | grep -q 'linux/arm64'; then
        ok "${ref}  manifest lists linux/arm64"
      elif printf '%s' "$out" | grep -qiE 'connection|timeout|no such host|denied|unauthorized'; then
        bad "${ref}  the registry could not be reached, so its manifest was not checked. This recipe runs on the BUILD machine, which needs network; it is not part of 'just up'."
      else
        bad "${ref}  manifest lists only: $(printf '%s' "$out" | grep -o 'linux/[a-z0-9]*' | sort -u | tr '\n' ' ')"
      fi
    done

    ours domo-twin domo-twin
    ours domo-tools domo-bootstrap

    if [ "$fail" -eq 0 ]; then echo "✓ images-verify"; else echo "✗ images-verify"; exit 1; fi

# --- the staged, resumable checklist (D-34) ----------------------------------

# One command from a clean machine to a running stack (PLAT-01).
#
# # The ten stages, and who runs each
#
# D-34 names the sequence: preflight, pki, axiam-up, org-bootstrap, tenants,
# catalog, service-certs, broker, platform-up, verify. The split follows D-35:
# `just` owns everything that needs the Docker daemon or the host filesystem —
# compose lifecycle, volume removal, scraping the setup token from the FULL log
# history, tailing a failing container's log — and `domo-bootstrap` owns the
# AXIAM API work from inside the compose network. That split is what lets the
# Raspberry Pi bootstrap the demo with no cargo toolchain installed, while the
# bootstrap still reaches `axiam-server` and `rabbitmq` by the very names their
# certificates carry as SANs.
#
# `tenants` is three subcommands under one name (tenants, the BYOK root import
# and its signing CAs, and each tenant's admin). They are inseparable: a signing
# CA cannot exist before its tenant, and no tenant-scoped call can be made
# without that tenant's own admin (D-37). `tools/domo-bootstrap/src/state.rs`
# holds the same sequence on the container side.
#
# # A marker is a skip hint, never the truth
#
# A stage is skipped only when `.secrets/state/<stage>` exists AND a re-probe
# says the work is genuinely there. A run that died just after writing its
# marker leaves a marker with nothing behind it, and believing it would skip
# that stage forever — which is the failure this project has already seen once
# in the form of a zero-length `.done` file.
#
# # `resuming at: <stage>`
#
# Printed before the first stage that is actually RUN when earlier ones were
# skipped. Without it, a run that correctly skipped nine stages and a run that
# silently redid them look identical from the outside.
up:
    #!/usr/bin/env bash
    set -uo pipefail

    # --- the sequence --------------------------------------------------------
    # Mirrors state.rs's Stage::ALL. `preflight` and `verify` are deliberately
    # NOT resumable: they are checks, so "already done" is never an answer —
    # and if they were, a converged run would report itself as resuming.
    STAGES=(preflight pki axiam-up org-bootstrap tenants catalog service-certs broker platform-up verify)
    RESUMABLE=" pki axiam-up org-bootstrap tenants catalog service-certs broker platform-up "

    STATE_DIR=.secrets/state
    resumed=""
    skipped=0

    headline() {
      case "$1" in
        preflight)     echo "disk, tools, host and ports" ;;
        pki)           echo "the offline organization root and every SAN leaf" ;;
        axiam-up)      echo "SurrealDB, AXIAM and the broker" ;;
        org-bootstrap) echo "the organization and its super-admin" ;;
        tenants)       echo "tenants, the BYOK root import, signing CAs and tenant admins" ;;
        catalog)       echo "the role and permission catalog, applied and converged" ;;
        service-certs) echo "service accounts, their certificates and the portfolio roots" ;;
        broker)        echo "the 'domo' MQTT vhost" ;;
        platform-up)   echo "the Twin, PostgreSQL, Caddy and the AXIAM console" ;;
        verify)        echo "the invariants, and the demo card" ;;
      esac
    }

    # Which container's log explains a failure here. Naming the wrong one sends
    # the reader to a quiet log and teaches them the hint is useless.
    log_container() {
      case "$1" in
        axiam-up|org-bootstrap|tenants|catalog|service-certs) echo axiam-server ;;
        broker)                                               echo rabbitmq ;;
        platform-up|verify)                                   echo caddy ;;
        *)                                                    echo "" ;;
      esac
    }

    # An empty cause means the stage already printed its own `✗` line — the
    # AXIAM-facing stages render themselves, inside the container. Printing a
    # second one here would make every remote failure look like two.
    die() {
      local stage="$1" cause="$2" c
      [ -n "$cause" ] && printf '✗ %s  %s\n' "$stage" "$cause"
      c="$(log_container "$stage")"
      if [ -n "$c" ] && [ -n "$(just _dc ps -q "$c" 2>/dev/null)" ]; then
        printf '  the last lines of the %s log:\n' "$c"
        just _dc logs --no-color --tail 40 "$c" 2>&1 | sed 's/^/    /'
      fi
      printf "  re-run 'just up' to resume at: %s\n" "$stage"
      exit 1
    }

    mark() {
      mkdir -p "$STATE_DIR"
      umask 077
      printf '{\n  "stage": "%s",\n  "completed_at": "%s",\n  "produced": "%s"\n}\n' \
        "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" > "$STATE_DIR/$1"
      chmod 600 "$STATE_DIR/$1"
    }

    produced_of() {
      sed -n 's/.*"produced": "\(.*\)".*/\1/p' "$STATE_DIR/$1" 2>/dev/null | head -1
    }

    # The re-probe. Host stages are answered here; AXIAM-facing stages are
    # answered by `domo-bootstrap stage-probe`, which issues GETs and a login
    # and creates nothing.
    probe() {
      case "$1" in
        pki)
          [ -s .secrets/pki/root.pem ] || return 1
          [ -s dist/trust/domo-root.sha256 ] || return 1
          local n
          while IFS='|' read -r n _; do
            case "${n# }" in ''|\#*) continue ;; esac
            n="$(echo "$n" | tr -d '[:space:]')"
            [ -n "$n" ] || continue
            [ -s ".secrets/pki/${n}.pem" ] || return 1
          done < deploy/pki/listeners.conf
          return 0 ;;
        axiam-up)
          curl -sf --cacert .secrets/pki/root.pem https://127.0.0.1:8090/health >/dev/null 2>&1 ;;
        platform-up)
          # Caddy accepting its own configuration is the honest question, not
          # "is a container running": a container in a restart loop is running
          # for most of the time you look at it. The one-shot init services are
          # excluded from the count because they correctly exit.
          local want have
          want="$(just _dc config --services 2>/dev/null | grep -vcE '^(domo-bootstrap|domo-probe|surrealdb-init|tls-init)$')"
          have="$(just _dc ps -q --status running 2>/dev/null | grep -c .)"
          [ "$have" -ge "$want" ] || return 1
          just _dc exec -T caddy caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1 ;;
        *)
          just _stage stage-probe "$1" >/dev/null 2>&1 ;;
      esac
    }

    # --- the stages ----------------------------------------------------------

    do_preflight() { just preflight; }

    do_pki() {
      # Stale-volume refusal, copied from the sibling AXIAM justfile: minting a
      # fresh credential set against data volumes that still hold the OLD
      # credentials produces a broker and a database that refuse every login,
      # with nothing in the message about why.
      if [ ! -f "{{env_file}}" ] && [ -n "$(just _volumes-present)" ]; then
        echo "  ✗ {{env_file}} is missing while this project's data volumes still exist."
        echo "    Those volumes hold the credentials the old file minted, and RabbitMQ and"
        echo "    PostgreSQL apply credentials only on the FIRST boot of an empty volume."
        echo "    Run 'just demo-reset' to wipe them, or restore the file."
        return 1
      fi
      just secrets || return 1
      just pki || return 1
      just export-trust >/dev/null || return 1
    }

    do_axiam_up() {
      # The images this repository builds are built here rather than before the
      # sequence, so preflight has already refused if it was going to. `just
      # build` is a no-op when the layers are cached; `_images-fresh` is what
      # stops a stale image from silently running a previous plan's binary.
      just _images-fresh || return 1
      # An explicit list ONLY here: the Twin needs the tenant map the `tenants`
      # stage writes, and Caddy needs certificates that do not exist yet.
      # `platform-up` below starts everything with NO list, so a service added
      # by a later phase can never silently drop out of `just up` (D-06).
      just _dc up -d surrealdb-init tls-init surrealdb axiam-server rabbitmq || return 1
      just _wait-axiam || return 1
    }

    do_org_bootstrap() {
      just _setup-token || return 1
      just _stage stage-run org-bootstrap
    }

    do_platform_up() {
      # No service list, deliberately (plan 01-03): every service that is not
      # behind the `tools` profile starts here.
      just _dc up -d || return 1
      just _wait-edge
    }

    do_verify() {
      # `verify` always runs, even on a converged machine that skipped every
      # stage that would have recreated a container — so this is the one place
      # in `up` guaranteed to catch a service still running a superseded image.
      just _containers-fresh || return 1
      just _stage authz-verify || return 1
      just demo-card
    }

    # --- the run -------------------------------------------------------------

    for stage in "${STAGES[@]}"; do
      # The interruption hook, host side. Fires at the stage's ENTRY: before any
      # work and before its marker, so an interrupted run leaves exactly what a
      # real failure at this point would leave.
      #
      # ONLY for the stages this runner owns. A bootstrap-owned stage is gated
      # inside the container by `state::gate`, reached through the `-e
      # DOMO_FAIL_AT` that `_stage` forwards — short-circuiting it here would
      # make that forwarding untested, and an untested boundary crossing is
      # exactly the thing that silently stops working.
      case " preflight pki axiam-up platform-up verify " in
        *" $stage "*)
          if [ "${DOMO_FAIL_AT:-}" = "$stage" ]; then
            die "$stage" "DOMO_FAIL_AT=$stage — aborted at this stage's entry, before any work and before its marker"
          fi ;;
      esac

      if [[ "$RESUMABLE" == *" $stage "* ]] && [ -e "$STATE_DIR/$stage" ] && probe "$stage"; then
        printf '✓ %s  already done — %s\n' "$stage" "$(produced_of "$stage")"
        skipped=$(( skipped + 1 ))
        continue
      fi

      if [ -z "$resumed" ] && [ "$skipped" -gt 0 ] && [[ "$RESUMABLE" == *" $stage "* ]]; then
        printf 'resuming at: %s\n' "$stage"
        resumed=1
      fi

      case "$stage" in
        preflight)     printf '→ %s  %s\n' "$stage" "$(headline "$stage")"; do_preflight || die "$stage" "a preflight check refused; nothing was started or changed" ;;
        pki)           printf '→ %s  %s\n' "$stage" "$(headline "$stage")"; do_pki       || die "$stage" "the offline PKI could not be issued" ;;
        axiam-up)      printf '→ %s  %s\n' "$stage" "$(headline "$stage")"; do_axiam_up  || die "$stage" "the AXIAM half of the stack did not come up" ;;
        org-bootstrap) do_org_bootstrap || die "$stage" "the organization could not be bootstrapped. 'reset required' in the output above means the one-time setup token is gone and only 'just demo-reset' can recover this volume" ;;
        platform-up)   printf '→ %s  %s\n' "$stage" "$(headline "$stage")"; do_platform_up || die "$stage" "a platform service did not come up" ;;
        verify)        printf '→ %s  %s\n' "$stage" "$(headline "$stage")"; do_verify   || die "$stage" "an invariant is broken; the lines above name which" ;;
        *)             just _stage stage-run "$stage" || die "$stage" "" ;;
      esac

      # The AXIAM-facing stages write their own marker inside the container,
      # with what they actually produced. The host stages are marked here.
      case "$stage" in
        preflight)   mark "$stage" "disk, tools and ports checked" ;;
        pki)         mark "$stage" "root $(cut -d= -f2 dist/trust/domo-root.sha256 2>/dev/null | tr -d ' ')" ;;
        axiam-up)    mark "$stage" "axiam-server answering on :8090" ;;
        platform-up) mark "$stage" "every non-tools service running" ;;
        verify)      mark "$stage" "invariants asserted, demo card written" ;;
      esac

      case "$stage" in
        preflight|pki|axiam-up|platform-up|verify)
          printf '✓ %s  %s\n' "$stage" "$(produced_of "$stage")" ;;
      esac
    done

    just _disk-guard
    echo "✓ up"

# The ten D-34 stages and what this machine has done, read from the markers.
checklist:
    @just _stage checklist

# Print the demo card and write it to .secrets/demo-card.txt at 0600 (D-36).
#
# The fingerprint comes from dist/trust/domo-root.sha256 rather than from a
# fresh `openssl` call, because `just export-trust` has already asserted that
# file round-trips to the in-use root — reading it here keeps one source of
# truth and makes a rotated root show up on the card with no code change.
demo-card:
    @set -a; if [ -f .env ]; then . ./.env; fi; set +a; \
    test -s dist/trust/domo-root.sha256 \
        || { echo "✗ demo-card: dist/trust/domo-root.sha256 is missing — run 'just export-trust'"; exit 1; }; \
    just _stage demo-card \
        --host "${DOMO_HOST:-domo.local}" \
        --fingerprint "$(cut -d= -f2 dist/trust/domo-root.sha256 | tr -d ' ')"

# --- reset (D-09, D-10) -------------------------------------------------------

# Wipe this project's state and rebuild it, keeping the organization root.
#
# # Why volumes, and not the API
#
# Tearing down through AXIAM would have to satisfy `tenants.delete`'s 409
# precondition (an `export_audit` within the last 6 hours) and would leave
# whatever it could not delete. Removing the volumes is the path that stays
# idempotent and survives interruption (D-09).
#
# # Named, one by one. Never pruned.
#
# Docker's blanket volume-pruning subcommand would also destroy the SIBLING
# AXIAM checkout's development volumes, which are not ours to touch. The list
# comes from the compose file itself, so a volume a later phase adds is removed
# too — and each removal still names exactly one volume.
#
# That command's exact two-word name is deliberately not written anywhere in
# `just/`, `scripts/` or `tools/`: the prohibition is asserted by a raw grep, so
# a comment mentioning it verbatim would fail the check it exists to support.
# Plan 01-03 hit the identical trap with `tls internal` in the Caddyfile.
#
# # The root survives (D-10)
#
# Every marker is cleared EXCEPT `pki-root.done`, `gen-pki.sh`'s root guard.
# Rotating the root invalidates the trust every browser, every LAN client and
# the simulator PC has already installed; that is `just pki-rotate-root`, it
# asks for confirmation, and it appears in no automated path.
demo-reset:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "→ demo-reset"

    if [ ! -f "{{env_file}}" ] && [ -n "$(just _volumes-present)" ]; then
      echo "  ✗ {{env_file}} is missing while this project's data volumes still exist."
      echo "    Minting a fresh credential set against old data gives a broker and a"
      echo "    database that refuse every login. Remove the volumes deliberately, or"
      echo "    restore the file, then run this again."
      exit 1
    fi

    just _dc down --remove-orphans || true

    removed=0
    for v in $(just _volumes-present); do
      docker volume rm "$v" >/dev/null && echo "  ✓ removed volume $v" && removed=$(( removed + 1 ))
    done
    [ "$removed" -eq 0 ] && echo "  … no volume of this project was present"

    # Markers: everything except the root guard.
    if [ -d .secrets/state ]; then
      find .secrets/state -maxdepth 1 -type f ! -name pki-root.done -delete
      echo "  ✓ stage markers cleared (pki-root.done kept — the root is never rotated by a reset)"
    fi

    # Material issued BENEATH the root by a CA that no longer exists. The root
    # itself and its offline-signed server leaves stay: they are re-issued from
    # the same key, so every machine that trusts the root still trusts them.
    rm -rf .secrets/probe .secrets/smoke .secrets/axiam/service
    rm -f .secrets/axiam/*-ca.pem
    echo "  ✓ tenant CAs and issued client material cleared; the organization root kept"

    just up

# Every volume of THIS compose project that currently exists, one per line.
#
# Derived from the compose file rather than hardcoded, so a volume a later phase
# declares is covered without editing the reset path — the way a reset silently
# stops being a reset.
_volumes-present:
    @set -a; if [ -f .env ]; then . ./.env; fi; set +a; \
    p="${COMPOSE_PROJECT_NAME:-domo}"; \
    for v in $(just _dc config --volumes 2>/dev/null); do \
        docker volume inspect "${p}_${v}" >/dev/null 2>&1 && echo "${p}_${v}"; \
    done; true

# Build the two images this repository owns, but only when they are stale.
#
# This exists because of a real hour lost: a 33-hour-old `domo-tools:dev` ran a
# binary from before the subcommand being invoked existed, and clap's
# "unrecognized subcommand" reads exactly like a source bug. No recipe depended
# on `just build`, so nothing ever noticed.
#
# Freshness is image creation time versus the newest mtime under the paths that
# go into the image. Cheap, and it names the reason when it rebuilds.
_images-fresh:
    @newest=$(find Cargo.toml Cargo.lock crates tools services deploy/docker/Dockerfile.rust \
                -printf '%T@\n' 2>/dev/null | sort -rn | head -1 | cut -d. -f1); \
    stale=0; \
    for i in domo-twin domo-tools; do \
        built=$(docker image inspect "${i}:${DOMO_IMAGE_TAG:-dev}" 2>/dev/null \
                | sed -n 's/.*"Created": "\([^"]*\)".*/\1/p' | head -1); \
        if [ -z "$built" ]; then echo "  … ${i} image is absent"; stale=1; continue; fi; \
        b=$(date -d "$built" +%s 2>/dev/null || echo 0); \
        if [ "$b" -lt "${newest:-0}" ]; then \
            echo "  … ${i} image is older than the source it was built from"; stale=1; \
        fi; \
    done; \
    if [ "$stale" -eq 1 ]; then just build; else echo "  ✓ images match the source"; fi

# Recreate any running container whose image is not the one its tag now names.
#
# `_images-fresh` is half of the stale-binary trap. This is the other half: a
# fresh IMAGE is not a fresh CONTAINER. Rebuilding `domo-twin:dev` does not
# touch the Twin that is already running, and a converged `just up` skips the
# stages that would recreate it. That is exactly how plan 01-06's whole live
# matrix ran against the 01-01 tracer's Twin (image 028b0a1434f6, built before
# 01-05's strict request forms existed), and why the hardened Twin met a real
# broker for the first time in plan 01-07 and failed on the first request.
#
# Generic over every running service, not just ours: each container's image is
# compared with what its own configured reference resolves to now. Only a
# mismatch is acted on, one service at a time, `--no-deps` so nothing else moves.
_containers-fresh: _images-fresh
    @n=0; \
    for c in $(just _dc ps -q 2>/dev/null); do \
        oneoff=$(docker inspect --format '{{"{{"}}index .Config.Labels "com.docker.compose.oneoff"{{"}}"}}' "$c" 2>/dev/null) || continue; \
        [ "$oneoff" = "True" ] && continue; \
        ref=$(docker inspect --format '{{"{{"}}.Config.Image{{"}}"}}' "$c" 2>/dev/null) || continue; \
        cur=$(docker inspect --format '{{"{{"}}.Image{{"}}"}}' "$c" 2>/dev/null) || continue; \
        want=$(docker image inspect --format '{{"{{"}}.Id{{"}}"}}' "$ref" 2>/dev/null || true); \
        [ -n "$want" ] && [ "$cur" != "$want" ] || continue; \
        svc=$(docker inspect --format '{{"{{"}}index .Config.Labels "com.docker.compose.service"{{"}}"}}' "$c"); \
        echo "  … ${svc} is running ${cur:7:12}, but ${ref} is now ${want:7:12} — recreating it"; \
        just _dc up -d --no-deps "$svc" >/dev/null 2>&1 || { echo "  ✗ could not recreate ${svc}"; exit 1; }; \
        n=$((n+1)); \
    done; \
    [ "$n" -eq 0 ] && echo "  ✓ every running container runs the image its tag names" || echo "  ✓ recreated ${n} stale container(s)"

# --- the tracer --------------------------------------------------------------

# One command, empty machine to an accepted MQTT CONNECT.
#
# Every step prints → then ✓; a failure prints ✗ with the failing step and the
# tail of that container's log.
tracer: up
    @echo "→ tracer"
    @just _setup-token
    @just _stage org-bootstrap || { echo "✗ tracer: org-bootstrap"; just _dc logs --no-color --tail 40 axiam-server; exit 1; }
    @just _stage tenants        || { echo "✗ tracer: tenants";       just _dc logs --no-color --tail 40 axiam-server; exit 1; }
    @just _stage pki            || { echo "✗ tracer: pki";           just _dc logs --no-color --tail 40 axiam-server; exit 1; }
    @just _stage broker         || { echo "✗ tracer: broker";        just _dc logs --no-color --tail 40 rabbitmq;     exit 1; }
    @just _stage device-account --name domo-probe-device || { echo "✗ tracer: device-account"; just _dc logs --no-color --tail 40 axiam-server; exit 1; }
    @just _probe gen-csr        || { echo "✗ tracer: gen-csr"; exit 1; }
    @just _stage device-identity --csr /domo/.secrets/probe/device.csr --out /domo/.secrets/probe/leaf.pem \
        || { echo "✗ tracer: device-identity"; just _dc logs --no-color --tail 40 axiam-server; exit 1; }
    @just _probe connect || { echo "✗ tracer: probe connect"; just _dc logs --no-color --tail 60 rabbitmq; just _dc logs --no-color --tail 40 device-twin; exit 1; }
    @just _disk-guard
    @echo "✓ tracer"

# Disk hygiene: the project has run out of space mid-session before.
_disk-guard:
    @avail="$(df -BG --output=avail /home | tail -1 | tr -dc '0-9')"; \
    if [ -n "$avail" ] && [ "$avail" -lt "{{min_free_gb}}" ]; then \
        echo "  … under {{min_free_gb}}G free, clearing incremental build output"; \
        rm -rf target/debug/incremental; \
    fi
